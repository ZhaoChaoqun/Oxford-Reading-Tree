{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["quizType", "keywords", "q1", "q2"],
  "properties": {
    "quizType": {
      "type": "string",
      "enum": ["none", "keywords", "comprehension"]
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "q1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "options", "answer", "emoji"],
      "properties": {
        "type": { "type": "string", "enum": ["text"] },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "integer" },
        "emoji": { "type": "string" }
      }
    },
    "q2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "options", "answer", "emoji"],
      "properties": {
        "type": { "type": "string", "enum": ["text"] },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "integer" },
        "emoji": { "type": "string" }
      }
    }
  }
}
